{
  // What production runs, as opposed to what the editor and the tests read.
  //
  // `tsconfig.json` is `noEmit` and takes in scripts and tests as well —
  // right for typechecking, wrong for an image, which wants the source
  // compiled and nothing else. Two files rather than one with a flag,
  // because "which config built this" should be answerable by reading.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": false,
    "declaration": false,
    "sourceMap": true
  },
  // `src` alone: the seed, the load harness and the tests are development
  // tools and have no business in the thing that serves customers.
  "include": ["src/**/*.ts"]
}
