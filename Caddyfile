# TLS and the one door in.
#
# Caddy gets and renews the certificate from Let's Encrypt by itself, which
# is the whole reason it is here rather than nginx: a certificate that
# expires on a Sunday is the outage nobody schedules.

{
	# The redirect from plain HTTP is written below, so it can keep a port
	# that is not 443 (`HTTPS_PORT`). Certificates are still Caddy's to get.
	auto_https disable_redirects
}

http://{$DOMAIN} {
	redir https://{host}:{$HTTPS_PORT:443}{uri} permanent
}

{$DOMAIN} {
	# Websockets need no special handling — `reverse_proxy` passes the
	# upgrade through. Realtime is a socket per open screen, so a proxy that
	# quietly dropped them would look like a product that simply does not
	# update.
	reverse_proxy app:8787

	encode gzip zstd

	# The browser talks to this origin over TLS and nothing else, for a
	# year. A product holding other companies' documents has no business
	# being reachable in plaintext, even once, even by mistake. Not for
	# `localhost`, with a certificate of Caddy's own: a year of HTTPS-only
	# for every port and name under it would follow the browser into
	# whatever else runs there.
	# The app says it too, in production, so on `localhost` it is taken off
	# the answer as well, after the app has written it.
	@public not host localhost
	header @public Strict-Transport-Security "max-age=31536000; includeSubDomains"
	@local host localhost
	header @local {
		-Strict-Transport-Security
		defer
	}

	header {
		# Not framable: a tracker inside somebody else's page is a tracker
		# whose clicks somebody else can aim.
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# What the server says about itself is not a thing to advertise.
		-Server
	}

	# Uploads are the one thing that goes up large; everything else is JSON.
	request_body {
		max_size 100MB
	}
}
