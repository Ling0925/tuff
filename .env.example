# Settings, read from `.env` beside this file. docs/self-hosting.md says
# what each one does.
#
# On your own server, `scripts/setup.sh` writes `.env` for you with random
# secrets, and that is the way to start. Copying this file by hand works
# too: fill in the first block and leave the second one out.

# ---------------------------------------------------- docker compose
# Read by docker-compose.prod.yml. Passwords in letters and digits only
# (`openssl rand -hex 24`): they are written into a URL as they are.
COMPOSE_FILE=docker-compose.prod.yml
# The release that runs (ghcr.io/usetuff/tuff:<this>). scripts/update.sh
# moves it forward. To build from this checkout instead, add
# docker-compose.build.yml to COMPOSE_FILE (docs/self-hosting.md).
TUFF_VERSION=
DOMAIN=localhost
APP_URL=https://localhost
HTTP_PORT=80
HTTPS_PORT=443
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
WORKER_DB_PASSWORD=
JWT_SECRET=
# Encrypts second-factor secrets and GitHub/Slack/import tokens, apart from
# JWT_SECRET. Optional: without it they are encrypted with a key derived
# from JWT_SECRET. At least 32 characters (`openssl rand -hex 32`). To
# change it, move the old one to ENCRYPTION_KEY_PREVIOUS and run
# `server/dist/reseal.js` — docs/self-hosting.md, "Rotating the secrets".
ENCRYPTION_KEY=
# ENCRYPTION_KEY_PREVIOUS=

# ------------------------------------------------------- development
# Running the code itself (`pnpm dev`, `pnpm check`) against the Postgres in
# docker-compose.dev.yml. Not for docker compose above, which makes its own
# and ignores these.
DATABASE_URL=postgres://tracker:tracker@localhost:5455/tracker
DATABASE_URL_APP=postgres://tracker_app:tracker_app@localhost:5455/tracker
DATABASE_URL_WORKER=postgres://tracker_worker:tracker_worker@localhost:5455/tracker
# The sign-in role, tracker_auth (migration 308).
# Leave it out: it is made from DATABASE_URL_APP, and the migration gives the
# role that password. Set it only to choose the password yourself.
# DATABASE_URL_AUTH=postgres://tracker_auth:…@localhost:5455/tracker
PORT=8787

# ---------------------------------------------------- everything else
# All optional. Left empty, the feature says it is not set up and nothing
# else changes.

# Your own server's owner. Until somebody owns it, only this address may
# become the owner — on the setup screen, or by signing up and confirming
# it. Empty: any address, through the setup link; and with no SETUP_TOKEN
# either, the first person to sign up and confirm an address. Not read on
# the service.
OWNER_EMAIL=

# The setup link's one-time token: https://<domain>/setup?token=<this> opens
# the screen that sets up email and creates the owner's account, until the
# server has an owner. scripts/setup.sh writes it (openssl rand -hex 32) and
# the app prints the link on every start until then. At least 32 letters
# and digits; shorter refuses to start. Not read on the service.
SETUP_TOKEN=

# Once a day the worker asks GitHub whether a newer release of Tuff is out
# (one GET to api.github.com, sending nothing but the request itself), and
# Server settings says so. `off` stops the request. Not read on the service.
UPDATE_CHECK=

# Before it migrates the database — after an update, when the new version
# has migrations — the app dumps it into the `db-backups` volume
# (/backups/tuff-<old version>-m<migration>-<date>-<time>.dump) and does not start if
# the dump fails. Dumps older than BACKUP_RETENTION_DAYS (30) are deleted.
# SKIP_PRE_MIGRATION_BACKUP=1 migrates with no dump: only with backups of
# your own. Not read on the service.
BACKUP_RETENTION_DAYS=
SKIP_PRE_MIGRATION_BACKUP=

# Mail — through your own SMTP server, or through Resend. On your own
# server it can be set up in Server settings instead; set here, it wins
# and is read-only there. With none, nobody gets email (see "Mail" in
# README.md). With both, the community edition sends through SMTP.
# smtps://user:password@smtp.example.com:465 (TLS), or
# smtp://user:password@smtp.example.com:587 (STARTTLS, required when there is
# a password). Percent-encode @ : / in the user and password. No ?options.
# Anything but smtp: or smtps: refuses to start.
SMTP_URL=
# Who emails are from: an address your mail provider lets you send as,
# "tuff@example.com" or "Tuff <tuff@example.com>". On your own server it is
# required whenever mail is set up (SMTP_URL or RESEND_API_KEY), and the
# server refuses to start without it: there is no default sender.
MAIL_FROM=
RESEND_API_KEY=
# A mail server saved in Server settings must be at a public address. `1`
# allows a private one too — a relay of your own, like a `postfix`
# container on the compose network. Link-local and cloud metadata
# addresses are refused even then. Not read on the service.
SMTP_ALLOW_PRIVATE=

# Push notifications in the browser. One pair per server, kept: changing it
# ends every subscription anybody has granted. Left empty, your own server
# makes a pair on its first start and keeps it in the database, and the
# subject is the https origin of APP_URL. Set here (the command is in
# docs/self-hosting.md, or `pnpm --filter @tracker/server vapid`), these win.
# The service always sets them. The subject is a way to reach you.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Sign in with Google: redirect URI APP_URL/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sign in with Apple: Services ID, team, key id and the .p8 contents (\n for
# newlines); return URL APP_URL/auth/oauth/apple/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Sign in with GitHub, an OAuth App of your own:
# callback APP_URL/auth/oauth/github/callback
GITHUB_SIGNIN_CLIENT_ID=
GITHUB_SIGNIN_CLIENT_SECRET=
# Sign in with your own OpenID Connect provider (Keycloak, Pocket-ID,
# Authentik, Okta...): its issuer and a confidential client, redirect URI
# APP_URL/auth/oauth/oidc/callback. OIDC_NAME is what the button says
# ("Continue with SSO" without it). The oidc sign in spec
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=

# Files in an S3-compatible bucket instead of the `uploads` volume. All four,
# or none.
STORAGE_S3_ENDPOINT=
STORAGE_S3_BUCKET=
STORAGE_S3_KEY=
STORAGE_S3_SECRET=
# STORAGE_S3_REGION=auto
